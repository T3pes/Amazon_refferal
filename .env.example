# Copia in .env.local per lo sviluppo. Mai committare valori reali.
AMAZON_PARTNER_TAG=dealsforev0bc-21
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# "Version" mostrata in Associates Central (es. 2.2 o 3.2)
AMAZON_CREATORS_VERSION=2.2
# Facoltativo: forza l'endpoint del token
AMAZON_CREATORS_TOKEN_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Indirizzo pubblico del sito (sitemap, anteprime social, link canonici)
NEXT_PUBLIC_SITE_URL=https://amazonrefferal.vercel.app

# Gruppo Telegram (bot creato con @BotFather, amministratore del gruppo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Argomenti del gruppo: categoria del sito → numero argomento
TELEGRAM_TOPICS=
# Segreto per l'invio automatico giornaliero (Vercel Cron): una stringa casuale lunga
CRON_SECRET=
